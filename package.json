{
  "name": "js-bitcoinkernel",
  "version": "1.0.0-alpha.0",
  "description": "A JavaScript/TypeScript Bitcoin kernel that wraps native C/C++ functions to provide safe and structured access to Bitcoin data structures like block headers and hashes.",
  "main": "dist/js-kernel/index.js",
  "types": "dist/js-kernel/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && tsc-alias && node scripts/copy-binaries.mjs",
    "prepublishOnly": "npm run native:verify && npm run type-check && npm run lint && npm test && npm run build",
    "dev": "tsx ./src/js-kernel/index.ts",
    "test": "node --import tsx --test tests/test-*.ts tests/util/test-*.ts",
    "start": "node dist/js-kernel/index.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "native:build": "node scripts/build-native.mjs",
    "native:verify": "node scripts/verify-binaries.mjs"
  },
  "keywords": [
    "bitcoin",
    "bitcoin-core",
    "libbitcoinkernel",
    "ffi",
    "koffi",
    "typescript"
  ],
  "author": "Musa Haruna",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "koffi": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitepress": "^1.6.4"
  }
}
